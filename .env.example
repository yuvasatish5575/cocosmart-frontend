# Optional. Defaults to /api, which Vite's dev-server proxy forwards to
# http://localhost:4000 (see vite.config.ts) so the app only needs one port
# in local dev. Set an absolute URL here only when the API isn't reachable
# through that proxy (e.g. pointing at a deployed backend).
# VITE_API_URL=http://localhost:4000/api

# --- Optional overrides for `docker compose up` (repo-root docker-compose.yml) ---
# Uncomment and set real values before deploying anywhere but localhost; the
# compose file falls back to insecure development defaults otherwise.
# POSTGRES_USER=cocosmart
# POSTGRES_PASSWORD=cocosmart
# POSTGRES_DB=cocosmart
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=
# SEED_ADMIN_EMAIL=admin@cocosmart.test
# SEED_ADMIN_PASSWORD=ChangeMe123!

